<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- (1) Khối thống kê trên nền gradient -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_title"
            android:textColor="@color/white_80"
            android:textSize="14sp" />

        <!-- Giá trị kho: con số lớn nhất -->
        <TextView
            android:id="@+id/tvTotalValue"
            style="@style/StatValue"
            android:layout_marginTop="2dp"
            android:text="0 đ"
            android:textSize="30sp" />

        <TextView
            style="@style/StatLabel"
            android:text="@string/stats_value" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stats"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvTotalCount"
                    style="@style/StatValue"
                    android:text="0" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/stats_count" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stats"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvLowStock"
                    style="@style/StatValue"
                    android:text="0" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/stats_low" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:text="@string/list_title"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- (2) Danh sách sản phẩm + thông báo khi danh sách rỗng + (3) nút Thêm nổi phía dưới -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvProducts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:listSelector="@android:color/transparent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="96dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:paddingBottom="80dp"
            android:text="@string/list_empty"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAdd"
            style="@style/BigButton"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:elevation="6dp"
            android:text="@string/btn_add" />
    </FrameLayout>
</LinearLayout>
